# Terraform uses the currently selected Azure CLI subscription after `az login`.
# These optional values can be left null unless a service-principal workflow is used.
subscription_id     = null
tenant_id           = null
client_id           = null
client_secret       = null

location             = "westeurope"
project_name         = "calivora"
environment          = "prod"
node_vm_size         = "Standard_E2ads_v7"

# Set this after pushing the image to ACR, or let deploy.sh build and push it.
app_image            = ""

# Real provider test; add the newly rotated keys locally below.
offline_mode         = false
llm_provider         = "gemini"
llm_model            = "gemini-3.6-flash"
anthropic_api_key    = ""
openai_api_key       = ""
google_api_key       = ""
usda_api_key         = ""
